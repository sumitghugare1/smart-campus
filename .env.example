# ========================================================
# QTalk NextGen - Environment Variables Configuration
# ========================================================

# Server Port (Default: 5000)
PORT=5000

# JWT Secret Key for authenticating students, trainers, HR, and admins
# (Use any long, random alphanumeric secret string)
JWT_SECRET=qtalk_super_secret_jwt_key_2026_demo

# PostgreSQL Connection String (Hosted on Neon)
# Format: postgresql://[user]:[password]@[neon-hostname]/[database]?sslmode=require
# If left empty or commented out, the backend automatically uses embedded PostgreSQL (PGlite)
DATABASE_URL=postgresql://username:password@ep-sample-pool-123456.us-east-2.aws.neon.tech/neondb?sslmode=require

# Client URL (for CORS)
CLIENT_URL=http://localhost:5173
